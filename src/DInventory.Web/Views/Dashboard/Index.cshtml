@model DInventory.Application.Common.Models.DashboardStats
@{
    ViewData["Title"] = "Dashboard";
    var rangeLabels = new Dictionary<string, string>
    {
        ["today"] = "Today",
        ["7day"] = "Last 7 Days",
        ["1month"] = "Last 1 Month",
        ["1year"] = "Last 1 Year"
    };
    var rangeLabel = rangeLabels.TryGetValue(Model.Range, out var lbl) ? lbl : "Today";
    var avgOrderValue = Model.TotalOrders > 0 ? Model.RangeSales / Model.TotalOrders : 0m;
    var netAfterExpenses = Model.RangeSales - Model.RangeExpenses;
    var topProductMax = Model.TopProducts.Any() ? Model.TopProducts.Max(p => p.Revenue) : 0m;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h4 class="fw-bold mb-0">Dashboard</h4>
        <div class="text-muted small">Overview of your business performance &mdash; @rangeLabel.ToLower()</div>
    </div>
    <div class="d-flex align-items-center gap-2">
        <form method="get" class="d-flex align-items-center gap-2">
            <select name="range" class="form-select form-select-sm dinv-range-select" onchange="this.form.submit()">
                <option value="today" selected="@(Model.Range == "today")">Today</option>
                <option value="7day" selected="@(Model.Range == "7day")">Last 7 Days</option>
                <option value="1month" selected="@(Model.Range == "1month")">Last 1 Month</option>
                <option value="1year" selected="@(Model.Range == "1year")">Last 1 Year</option>
            </select>
        </form>
        <a asp-controller="Sales" asp-action="Create" class="btn btn-pos shadow-sm d-flex align-items-center gap-2">
            <i class="bi bi-cash-coin"></i>
            <span class="fw-semibold">New Sale</span>
        </a>
    </div>
</div>

<!-- Headline KPIs: the four numbers most users want at a glance for the selected period. -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="card kpi-card h-100">
            <div class="card-body d-flex align-items-start justify-content-between">
                <div>
                    <div class="text-muted small fw-medium mb-1">Total Sale</div>
                    <div class="fs-3 fw-bold">@Model.RangeSales.ToMoney()</div>
                    @if (Model.RangeGrowthPercent.HasValue)
                    {
                        var growthUp = Model.RangeGrowthPercent.Value >= 0;
                        <div class="small fw-semibold @(growthUp ? "text-success" : "text-danger") mt-1">
                            <i class="bi @(growthUp ? "bi-arrow-up-right" : "bi-arrow-down-right")"></i>
                            @Math.Abs(Model.RangeGrowthPercent.Value)% vs previous period
                        </div>
                    }
                    else
                    {
                        <div class="small text-muted mt-1">Avg order: @avgOrderValue.ToMoney()</div>
                    }
                </div>
                <span class="dinv-stat-icon bg-primary-subtle text-primary"><i class="bi bi-graph-up-arrow"></i></span>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card kpi-card h-100">
            <div class="card-body d-flex align-items-start justify-content-between">
                <div>
                    <div class="text-muted small fw-medium mb-1">Order Count</div>
                    <div class="fs-3 fw-bold">@Model.TotalOrders</div>
                    <div class="small text-muted mt-1">Avg order: @avgOrderValue.ToMoney()</div>
                </div>
                <span class="dinv-stat-icon bg-success-subtle text-success"><i class="bi bi-receipt"></i></span>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card kpi-card h-100">
            <div class="card-body d-flex align-items-start justify-content-between">
                <div>
                    <div class="text-muted small fw-medium mb-1">Total Product Sold</div>
                    <div class="fs-3 fw-bold">@Model.TotalProductSold</div>
                    <div class="small text-muted mt-1">units &middot; @rangeLabel.ToLower()</div>
                </div>
                <span class="dinv-stat-icon bg-info-subtle text-info"><i class="bi bi-box-seam"></i></span>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="card kpi-card h-100">
            <div class="card-body d-flex align-items-start justify-content-between">
                <div>
                    <div class="text-muted small fw-medium mb-1">Total Expense</div>
                    <div class="fs-3 fw-bold">@Model.RangeExpenses.ToMoney()</div>
                    <div class="small mt-1 @(netAfterExpenses >= 0 ? "text-success" : "text-danger")">
                        Net: @netAfterExpenses.ToMoney()
                    </div>
                </div>
                <span class="dinv-stat-icon bg-warning-subtle text-warning"><i class="bi bi-wallet2"></i></span>
            </div>
        </div>
    </div>
</div>

<!-- Primary chart + Top Products - the "what's actually happening" section. -->
<div class="row g-3 mb-4 align-items-stretch">
    <div class="col-lg-8">
        <div class="card shadow-sm h-100">
            <div class="card-header d-flex justify-content-between align-items-center bg-white">
                <span class="fw-semibold"><i class="bi bi-bar-chart-line me-1 text-primary"></i>Sales Trend</span>
                <select id="rangeSelect" class="form-select form-select-sm w-auto">
                    <option value="daily" selected>Daily (14 days)</option>
                    <option value="weekly">Weekly</option>
                    <option value="monthly">Monthly</option>
                    <option value="yearly">Yearly</option>
                </select>
            </div>
            <div class="card-body">
                <canvas id="salesTrendChart" height="110"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold"><i class="bi bi-trophy me-1 text-warning"></i>Top Products</div>
            <div class="card-body">
                @if (!Model.TopProducts.Any())
                {
                    <p class="text-muted small mb-0">No sales recorded yet for @rangeLabel.ToLower().</p>
                }
                else
                {
                    <canvas id="topProductsChart" height="150" class="mb-3"></canvas>
                    <ul class="list-unstyled mb-0 dinv-top-products">
                        @for (var i = 0; i < Model.TopProducts.Count; i++)
                        {
                            var product = Model.TopProducts[i];
                            var pct = topProductMax > 0 ? (double)(product.Revenue / topProductMax) * 100 : 0;
                            <li class="mb-2">
                                <div class="d-flex justify-content-between small mb-1">
                                    <span class="fw-medium text-truncate">@(i + 1). @product.ProductName</span>
                                    <span class="text-muted">@product.Revenue.ToMoney()</span>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar" role="progressbar" style="width: @(pct)%"></div>
                                </div>
                                <div class="text-muted small mt-1">@product.QuantitySold units sold</div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

<!-- Secondary / supporting metrics - condensed into two compact multi-stat cards instead of eight
     separate ones, so the headline KPIs above stay the visual focus. -->
<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold"><i class="bi bi-calendar3 me-1 text-primary"></i>Sales at a Glance</div>
            <div class="card-body">
                <div class="row g-3 text-center">
                    <div class="col-3">
                        <div class="text-muted small">Today</div>
                        <div class="fw-semibold">@Model.TodaySales.ToMoney()</div>
                        <div class="text-muted small">@Model.TodayOrderCount order(s)</div>
                    </div>
                    <div class="col-3">
                        <div class="text-muted small">This Week</div>
                        <div class="fw-semibold">@Model.WeekSales.ToMoney()</div>
                    </div>
                    <div class="col-3">
                        <div class="text-muted small">This Month</div>
                        <div class="fw-semibold">@Model.MonthSales.ToMoney()</div>
                    </div>
                    <div class="col-3">
                        <div class="text-muted small">This Year</div>
                        <div class="fw-semibold">@Model.YearSales.ToMoney()</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold"><i class="bi bi-shop me-1 text-success"></i>Inventory &amp; Cash</div>
            <div class="card-body">
                <div class="row g-3 text-center">
                    <div class="col-3">
                        <i class="bi bi-box-seam text-primary"></i>
                        <div class="fw-semibold">@Model.TotalProducts</div>
                        <div class="text-muted small">Products</div>
                    </div>
                    <div class="col-3">
                        <i class="bi bi-exclamation-triangle text-danger"></i>
                        <div class="fw-semibold">@Model.LowStockCount</div>
                        <div class="text-muted small">Low Stock</div>
                    </div>
                    <div class="col-3">
                        <i class="bi bi-people text-info"></i>
                        <div class="fw-semibold">@Model.TotalCustomers</div>
                        <div class="text-muted small">Customers</div>
                    </div>
                    <div class="col-3">
                        <i class="bi bi-wallet2 text-warning"></i>
                        <div class="fw-semibold">@Model.CashInHand.ToMoney()</div>
                        <div class="text-muted small">Cash (today)</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold"><i class="bi bi-bar-chart-steps me-1 text-info"></i>Monthly Sales Growth (Last 6 Months)</div>
            <div class="card-body">
                @if (Model.MonthlyTrend.Any(p => p.Total > 0))
                {
                    <canvas id="monthlyGrowthChart" height="80"></canvas>
                }
                else
                {
                    <p class="text-muted small mb-0">Not enough sales history yet to chart monthly growth.</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .btn-pos {
            min-height: 42px;
            padding: 0.5rem 1.25rem;
            border-radius: 0.6rem;
            background: linear-gradient(135deg, #0d6efd, #0a58ca);
            border: none;
            color: #fff;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }
        .btn-pos:hover, .btn-pos:focus {
            background: linear-gradient(135deg, #0b5ed7, #0a53be);
            transform: translateY(-1px);
            color: #fff;
        }
        .dinv-range-select {
            min-width: 150px;
        }
        .dinv-stat-icon {
            width: 44px;
            height: 44px;
            border-radius: 0.65rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.15rem;
            flex-shrink: 0;
        }
        .dinv-top-products .progress {
            background-color: #eef1f5;
        }
    </style>
    <script src="~/lib/chartjs/chart.umd.min.js" asp-append-version="true"></script>
    <script>
        const initialTrend = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Trend));
        const dashboardBusinessUnitId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((int?)ViewData["BusinessUnitId"]));

        function buildTrendGradient(ctx) {
            const gradient = ctx.createLinearGradient(0, 0, 0, 260);
            gradient.addColorStop(0, 'rgba(13,110,253,0.28)');
            gradient.addColorStop(1, 'rgba(13,110,253,0.02)');
            return gradient;
        }

        const trendCtx = document.getElementById('salesTrendChart').getContext('2d');
        const chart = new Chart(trendCtx, {
            type: 'line',
            data: {
                labels: initialTrend.map(p => p.label),
                datasets: [{
                    label: 'Net Sales',
                    data: initialTrend.map(p => p.total),
                    borderColor: '#0d6efd',
                    backgroundColor: buildTrendGradient(trendCtx),
                    pointBackgroundColor: '#0d6efd',
                    pointRadius: 3,
                    pointHoverRadius: 5,
                    tension: 0.35,
                    fill: true
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: (item) => ' ' + dinvMoney(item.parsed.y)
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { callback: (value) => dinvMoney(value) },
                        grid: { color: '#f0f1f3' }
                    },
                    x: { grid: { display: false } }
                }
            }
        });

        document.getElementById('rangeSelect').addEventListener('change', async (e) => {
            try {
                const buParam = dashboardBusinessUnitId ? `&businessUnitId=${dashboardBusinessUnitId}` : '';
                const response = await dinvFetch(`/api/dashboard/trend?range=${e.target.value}${buParam}`);
                if (!response.ok) return;
                const points = await response.json();
                chart.data.labels = points.map(p => p.label);
                chart.data.datasets[0].data = points.map(p => p.total);
                chart.update();
            } catch (err) {
                console.error('Failed to load trend data', err);
            }
        });

        const topProductsCanvas = document.getElementById('topProductsChart');
        if (topProductsCanvas) {
            const topProducts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TopProducts));
            const palette = ['#0d6efd', '#20c997', '#ffc107', '#fd7e14', '#6f42c1', '#e83e8c', '#0dcaf0'];
            new Chart(topProductsCanvas.getContext('2d'), {
                type: 'doughnut',
                data: {
                    labels: topProducts.map(p => p.productName),
                    datasets: [{
                        data: topProducts.map(p => p.revenue),
                        backgroundColor: topProducts.map((_, i) => palette[i % palette.length]),
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    cutout: '65%',
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: (item) => ` ${item.label}: ${dinvMoney(item.parsed)}`
                            }
                        }
                    }
                }
            });
        }

        const monthlyGrowthCanvas = document.getElementById('monthlyGrowthChart');
        if (monthlyGrowthCanvas) {
            const monthlyTrend = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyTrend));
            const totals = monthlyTrend.map(p => p.total);
            const barColors = totals.map((t, i) => {
                if (i === 0) return '#94a3b8';
                return t >= totals[i - 1] ? '#20c997' : '#dc3545';
            });
            new Chart(monthlyGrowthCanvas.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: monthlyTrend.map(p => p.label),
                    datasets: [{
                        label: 'Monthly Sales',
                        data: totals,
                        backgroundColor: barColors,
                        borderRadius: 6,
                        maxBarThickness: 56
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: (item) => ' ' + dinvMoney(item.parsed.y)
                            }
                        }
                    },
                    scales: {
                        y: { beginAtZero: true, ticks: { callback: (value) => dinvMoney(value) } },
                        x: { grid: { display: false } }
                    }
                }
            });
        }
    </script>
}
