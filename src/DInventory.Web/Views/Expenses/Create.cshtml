@model DInventory.Domain.Entities.Expense
@{
    ViewData["Title"] = "New Expense";
    var categories = (string[])ViewBag.Categories;
}
<div class="card shadow-sm">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <form method="post">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Expense Date</label>
                    <input asp-for="ExpenseDate" type="date" class="form-control" value="@Model.ExpenseDate.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Category</label>
                    <select asp-for="Category" class="form-select" required>
                        <option value="">-- Select category --</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Amount</label>
                    <input asp-for="Amount" type="number" step="0.01" min="0" class="form-control" required />
                </div>
                <div class="col-12">
                    <label class="form-label">Remarks</label>
                    <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Save Expense</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
