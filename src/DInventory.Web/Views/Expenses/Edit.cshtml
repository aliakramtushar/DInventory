@model DInventory.Domain.Entities.Expense
@{
    ViewData["Title"] = "Edit Expense";
    var categories = (IEnumerable<DInventory.Domain.Entities.ExpenseCategory>)ViewBag.ExpenseCategories;
    var subcategories = (IEnumerable<DInventory.Domain.Entities.ExpenseSubcategory>)ViewBag.ExpenseSubcategories;
}
<div class="card shadow-sm">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <form method="post">
            <input asp-for="ExpenseId" type="hidden" />
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Expense Date <span class="text-danger">*</span></label>
                    <input asp-for="ExpenseDate" type="date" class="form-control" value="@Model.ExpenseDate.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Category <span class="text-danger">*</span></label>
                    <select asp-for="ExpenseCategoryId" class="form-select" required>
                        @foreach (var c in categories)
                        {
                            <option value="@c.ExpenseCategoryId" selected="@(c.ExpenseCategoryId == Model.ExpenseCategoryId)">@c.ExpenseCategoryName</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Subcategory</label>
                    <select asp-for="ExpenseSubcategoryId" id="expenseSubcategorySelect" class="form-select">
                        <option value="">-- None --</option>
                        @foreach (var sub in subcategories)
                        {
                            <option value="@sub.ExpenseSubcategoryId" data-expense-category-id="@sub.ExpenseCategoryId" selected="@(sub.ExpenseSubcategoryId == Model.ExpenseSubcategoryId)">@sub.ExpenseSubcategoryName</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Amount <span class="text-danger">*</span></label>
                    <input asp-for="Amount" type="number" step="0.01" min="0" class="form-control" required />
                </div>
                <div class="col-12">
                    <label class="form-label">Remarks</label>
                    <textarea asp-for="Remarks" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Subcategory must always depend on Category: only show subcategories that belong to
        // whichever category is currently selected, and clear the pick if it no longer matches.
        (function () {
            const categorySelect = document.getElementById('ExpenseCategoryId');
            const subcategorySelect = document.getElementById('expenseSubcategorySelect');
            if (!categorySelect || !subcategorySelect) {
                return;
            }

            function filterSubcategories() {
                const categoryId = categorySelect.value;
                let selectedStillValid = false;

                Array.from(subcategorySelect.options).forEach((option) => {
                    if (!option.value) {
                        option.hidden = false;
                        return;
                    }

                    const matches = !categoryId || option.dataset.expenseCategoryId === categoryId;
                    option.hidden = !matches;
                    if (matches && option.value === subcategorySelect.value) {
                        selectedStillValid = true;
                    }
                });

                if (!selectedStillValid) {
                    subcategorySelect.value = '';
                }
            }

            categorySelect.addEventListener('change', filterSubcategories);
            filterSubcategories();
        })();
    </script>
}
