@model DInventory.Application.Common.Models.PagedResult<DInventory.Domain.Entities.Expense>
@{
    ViewData["Title"] = "Expenses";
    var categories = (string[])ViewBag.Categories;
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <form class="d-flex gap-2 flex-wrap" method="get">
        <input type="date" name="fromDate" value="@ViewData["FromDate"]" class="form-control form-control-sm" />
        <input type="date" name="toDate" value="@ViewData["ToDate"]" class="form-control form-control-sm" />
        <select name="category" class="form-select form-select-sm">
            <option value="">All Categories</option>
            @foreach (var c in categories)
            {
                <option value="@c" selected="@(ViewData["Category"]?.ToString() == c)">@c</option>
            }
        </select>
        <button class="btn btn-sm btn-outline-secondary" type="submit"><i class="bi bi-filter"></i> Filter</button>
    </form>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>New Expense</a>
</div>
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Date</th><th>Category</th><th>Remarks</th><th class="text-end">Amount</th><th>Recorded By</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No expenses found.</td></tr>
                }
                @{ decimal totalAmount = 0; }
                @foreach (var expense in Model.Items)
                {
                    totalAmount += expense.Amount;
                    <tr>
                        <td class="small">@expense.ExpenseDate.ToString("d")</td>
                        <td><span class="badge text-bg-light text-dark">@expense.Category</span></td>
                        <td class="text-muted small">@expense.Remarks</td>
                        <td class="text-end">@expense.Amount.ToMoney()</td>
                        <td class="small">@expense.CreatedByName</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@expense.ExpenseId"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Delete" asp-route-id="@expense.ExpenseId" method="post" class="d-inline" onsubmit="return confirm('Delete this expense?');">
                                    <button class="btn btn-outline-danger" type="submit"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="fw-bold"><td colspan="3" class="text-end">Total (this page)</td><td class="text-end">@totalAmount.ToMoney()</td><td colspan="2"></td></tr>
            </tfoot>
        </table>
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white">
            @await Html.PartialAsync("_Pagination", new PaginationViewModel
            {
                PageNumber = Model.PageNumber,
                TotalPages = Model.TotalPages,
                HasPreviousPage = Model.HasPreviousPage,
                HasNextPage = Model.HasNextPage,
                RouteValues = PaginationViewModel.Filters(
                    ("fromDate", ViewData["FromDate"]?.ToString()),
                    ("toDate", ViewData["ToDate"]?.ToString()),
                    ("category", ViewData["Category"]?.ToString()))
            })
        </div>
    }
</div>
