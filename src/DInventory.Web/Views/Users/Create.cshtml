@model DInventory.Domain.Entities.User
@{
    ViewData["Title"] = "New User";
    bool canCreate = ViewBag.CanCreate ?? false;
}
<div class="card shadow-sm">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        @if (!canCreate)
        {
            <div class="alert alert-warning">
                Select a company from the <strong>Company</strong> dropdown in the top navigation bar before creating a user - "All Companies" can't own one.
            </div>
        }
        <form method="post">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Full Name <span class="text-danger">*</span></label>
                    <input asp-for="FullName" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Username <span class="text-danger">*</span></label>
                    <input asp-for="Username" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Email <span class="text-danger">*</span></label>
                    <input asp-for="Email" type="email" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Password <span class="text-danger">*</span></label>
                    <input name="password" type="text" class="form-control" required minlength="5" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Role <span class="text-danger">*</span></label>
                    <select asp-for="RoleId" class="form-select" asp-items="@(new SelectList(ViewBag.Roles, "RoleId", "RoleName"))" required></select>
                </div>
            </div>
            @* Company and Business Unit are no longer picked here - both come from the Company /
               Business Unit selectors in the top navigation bar, same as every other record type. *@
            <input asp-for="CompanyId" type="hidden" />
            <input asp-for="BusinessUnitId" type="hidden" />
            <div class="mt-4">
                <button type="submit" class="btn btn-primary" disabled="@(!canCreate)">Create User</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
