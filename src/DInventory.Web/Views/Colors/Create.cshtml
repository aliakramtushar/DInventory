@model DInventory.Domain.Entities.Color
@{
    ViewData["Title"] = "New Color";
}
<div class="card shadow-sm">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <form method="post">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Color Name</label>
                    <input asp-for="ColorName" class="form-control" placeholder="e.g. Navy Blue, Maroon" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Hex Code</label>
                    <input asp-for="HexCode" type="color" class="form-control form-control-color" value="#000000" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Display Order</label>
                    <input asp-for="DisplayOrder" type="number" class="form-control" />
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Create Color</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
