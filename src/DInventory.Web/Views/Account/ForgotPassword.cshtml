@model DInventory.Application.Common.Models.ForgotPasswordRequest
@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_LoginLayout";
}
@if (ViewData["Submitted"] is true)
{
    <div class="alert alert-success">If an account exists for that email, a password reset link has been sent.</div>
    <a class="btn btn-outline-secondary w-100" asp-controller="Account" asp-action="Login">Back to Login</a>
}
else
{
    <p class="text-muted small">Enter your account email and we'll send you a link to reset your password.</p>
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <form asp-controller="Account" asp-action="ForgotPassword" method="post">
        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" autofocus />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100">Send Reset Link</button>
    </form>
    <div class="text-center mt-3">
        <a asp-controller="Account" asp-action="Login" class="small">Back to Login</a>
    </div>
}
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
