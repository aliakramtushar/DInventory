@model DInventory.Domain.Entities.ContentPage?
@{
    ViewData["Title"] = "Welcome";
    Layout = "_PublicLayout";
}

<!-- Hero -->
<section class="dinv-hero dinv-dotgrid rounded-4 px-4 px-md-5 py-5 mb-5 position-relative overflow-hidden">
    <div class="position-relative mx-auto text-center" style="max-width:700px;">
        <div class="dinv-eyebrow text-white mb-3">
            <span class="dinv-eyebrow-rule"></span>
            <span>Free installation &mdash; use it first, pay later</span>
        </div>
        <h1 class="display-5 mb-3">Inventory + POS, made simple.</h1>
        <p class="lead text-muted-hero mb-4">
            DInventory keeps your stock, sales, and reports in one place &mdash; so running the shop
            takes less effort and less guesswork.
        </p>
        <div class="d-flex flex-wrap justify-content-center gap-2">
            <a asp-controller="Account" asp-action="Login" class="btn btn-light btn-lg fw-semibold shadow-sm">
                <i class="bi bi-box-arrow-in-right me-2"></i>Admin Login
            </a>
            <a asp-controller="Home" asp-action="Products" class="btn btn-outline-light btn-lg fw-semibold">
                Browse Products
            </a>
        </div>
    </div>
</section>

<!-- Stat strip -->
<section class="mb-5">
    <div class="dinv-stat-strip row g-0 text-center py-4 px-2">
        <div class="col-md-4 dinv-stat">
            <div class="dinv-stat-number">Live</div>
            <div class="text-muted small">Stock tracked in real time</div>
        </div>
        <div class="col-md-4 dinv-stat">
            <div class="dinv-stat-number">1</div>
            <div class="text-muted small">Place for sales, profit &amp; expenses</div>
        </div>
        <div class="col-md-4 dinv-stat">
            <div class="dinv-stat-number">3+</div>
            <div class="text-muted small">Separate roles: owner, manager, cashier</div>
        </div>
    </div>
</section>

<!-- Features -->
<section class="mb-5">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="d-flex align-items-start gap-3">
                <div class="dinv-icon bg-primary-subtle text-primary"><i class="bi bi-box-seam"></i></div>
                <div>
                    <h5 class="fw-semibold mb-1">Stock</h5>
                    <p class="text-muted small mb-0">Know what's in the shop and what's running low, always.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="d-flex align-items-start gap-3">
                <div class="dinv-icon bg-success-subtle text-success"><i class="bi bi-bar-chart-line"></i></div>
                <div>
                    <h5 class="fw-semibold mb-1">Reports</h5>
                    <p class="text-muted small mb-0">Sales, profit and expenses, in plain numbers.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="d-flex align-items-start gap-3">
                <div class="dinv-icon bg-warning-subtle text-warning"><i class="bi bi-people"></i></div>
                <div>
                    <h5 class="fw-semibold mb-1">Users</h5>
                    <p class="text-muted small mb-0">Separate logins for owners, managers, and cashiers.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- How it works -->
<section class="dinv-steps mb-5 py-5">
    <div class="dinv-eyebrow justify-content-center text-primary mb-2 d-flex">
        <span class="dinv-eyebrow-rule"></span>
        <span>How it works</span>
    </div>
    <h2 class="fw-bold text-center mb-5">Try it first. Pay when you're sure.</h2>
    <div class="row g-4 text-center">
        <div class="col-md-4">
            <div class="dinv-step-number mx-auto mb-3">1</div>
            <h6 class="fw-semibold">We install it free</h6>
            <p class="text-muted small mb-0">No cost, no contract, no card.</p>
        </div>
        <div class="col-md-4">
            <div class="dinv-step-number mx-auto mb-3">2</div>
            <h6 class="fw-semibold">You run your shop</h6>
            <p class="text-muted small mb-0">Real sales, real stock, real results.</p>
        </div>
        <div class="col-md-4">
            <div class="dinv-step-number mx-auto mb-3">3</div>
            <h6 class="fw-semibold">Then you pay</h6>
            <p class="text-muted small mb-0">Only if you're happy with it.</p>
        </div>
    </div>
</section>

@if (Model != null && !string.IsNullOrWhiteSpace(Model.Body))
{
    <section class="mb-5">
        @Html.Raw(Model.Body)
    </section>
}
