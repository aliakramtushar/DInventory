@model DInventory.Domain.Entities.ContentPage
@{
    ViewData["Title"] = "Edit Page";
}
<div class="card shadow-sm">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <form method="post" enctype="multipart/form-data">
            <input asp-for="ContentPageId" type="hidden" />
            <input asp-for="ImagePath" type="hidden" />
            <div class="mb-3">
                <label class="form-label">Title</label>
                <input asp-for="Title" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">URL Slug</label>
                <input asp-for="Slug" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Image</label>
                @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
                {
                    <div class="mb-2"><img src="@Model.ImagePath" width="80" class="rounded" /></div>
                }
                <input name="imageFile" type="file" accept="image/*" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Body (HTML allowed)</label>
                <textarea asp-for="Body" class="form-control" rows="8"></textarea>
            </div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Display Order</label>
                    <input asp-for="DisplayOrder" type="number" class="form-control" />
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <div class="form-check">
                        <input asp-for="IsPublished" class="form-check-input" />
                        <label asp-for="IsPublished" class="form-check-label">Published</label>
                    </div>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Save Changes</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
