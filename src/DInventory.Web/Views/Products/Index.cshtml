@model DInventory.Application.Common.Models.PagedResult<DInventory.Domain.Entities.Product>
@{
    ViewData["Title"] = "Products";
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <form class="d-flex gap-2 flex-wrap" method="get">
        <select name="businessUnitId" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">All Business Units</option>
            @foreach (var bu in (IEnumerable<DInventory.Domain.Entities.BusinessUnit>)ViewBag.BusinessUnits)
            {
                <option value="@bu.BusinessUnitId" selected="@(ViewData["BusinessUnitId"]?.ToString() == bu.BusinessUnitId.ToString())">@bu.BusinessUnitName</option>
            }
        </select>
        <select name="categoryId" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">All Categories</option>
            @foreach (var cat in (IEnumerable<DInventory.Domain.Entities.Category>)ViewBag.Categories)
            {
                <option value="@cat.CategoryId" selected="@(ViewData["CategoryId"]?.ToString() == cat.CategoryId.ToString())">@cat.CategoryName</option>
            }
        </select>
        <select name="brandId" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">All Brands</option>
            @foreach (var brand in (IEnumerable<DInventory.Domain.Entities.Brand>)ViewBag.Brands)
            {
                <option value="@brand.BrandId" selected="@(ViewData["BrandId"]?.ToString() == brand.BrandId.ToString())">@brand.BrandName</option>
            }
        </select>
        <input type="text" name="search" value="@ViewData["Search"]" class="form-control form-control-sm" placeholder="Search products..." />
        <button class="btn btn-sm btn-outline-secondary" type="submit"><i class="bi bi-search"></i></button>
    </form>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>New Product</a>
</div>
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th></th><th>Code</th><th>Name</th><th>Brand</th><th>Category</th><th>Sizes</th><th>Selling Price</th><th>Website</th><th>Status</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="10" class="text-center text-muted py-4">No products found.</td></tr>
                }
                @foreach (var product in Model.Items)
                {
                    <tr>
                        <td style="width:48px;">
                            @if (!string.IsNullOrWhiteSpace(product.ImagePath))
                            {
                                <img src="@product.ImagePath" class="rounded" width="36" height="36" style="object-fit:cover;" />
                            }
                            else
                            {
                                <i class="bi bi-box-seam text-muted"></i>
                            }
                        </td>
                        <td><code>@product.ProductCode</code></td>
                        <td><a asp-action="Details" asp-route-id="@product.ProductId">@product.ProductName</a></td>
                        <td class="small">@product.BrandName</td>
                        <td class="small">@product.CategoryName</td>
                        <td><span class="badge text-bg-light text-dark">@product.VariantCount size(s)</span></td>
                        <td>@((product.SellingPrice ?? 0).ToMoney())</td>
                        <td class="small">
                            @if (product.IsShowOnWebsite)
                            {
                                <span class="badge text-bg-info">Visible</span>
                            }
                            else
                            {
                                <span class="badge text-bg-light text-dark">Hidden</span>
                            }
                        </td>
                        <td>@(product.IsActive ? "Active" : "Inactive")</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@product.ProductId"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Delete" asp-route-id="@product.ProductId" method="post" class="d-inline" onsubmit="return confirm('Delete this product?');">
                                    <button class="btn btn-outline-danger" type="submit"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white">
            @await Html.PartialAsync("_Pagination", new PaginationViewModel
            {
                PageNumber = Model.PageNumber,
                TotalCount = Model.TotalCount,
                PageSize = Model.PageSize,
                TotalPages = Model.TotalPages,
                HasPreviousPage = Model.HasPreviousPage,
                HasNextPage = Model.HasNextPage,
                RouteValues = PaginationViewModel.Filters(
                    ("search", ViewData["Search"]?.ToString()),
                    ("categoryId", ViewData["CategoryId"]?.ToString()),
                    ("brandId", ViewData["BrandId"]?.ToString()),
                    ("businessUnitId", ViewData["BusinessUnitId"]?.ToString()))
            })
        </div>
    }
</div>
