@model IEnumerable<DInventory.Domain.Entities.StockTransaction>
@{
    var stock = (DInventory.Domain.Entities.Stock?)ViewBag.Stock;
    ViewData["Title"] = "Stock History";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Stock History &mdash; @stock?.ProductName <span class="badge text-bg-light text-dark">@stock?.SizeName</span></h5>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Stock</a>
</div>
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Date</th><th>Type</th><th>Quantity</th><th>Reference</th><th>Remarks</th><th>By</th></tr></thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No stock transactions recorded yet.</td></tr>
                }
                @foreach (var tx in Model)
                {
                    <tr>
                        <td class="small">@tx.CreatedAt.ToString("g")</td>
                        <td><span class="badge @(tx.TransactionType == "IN" ? "text-bg-success" : "text-bg-danger")">@tx.TransactionType</span></td>
                        <td>@tx.Quantity</td>
                        <td class="small text-muted">@tx.ReferenceType @(tx.ReferenceId.HasValue ? "#" + tx.ReferenceId : "")</td>
                        <td class="small">@tx.Remarks</td>
                        <td class="small">@tx.CreatedByName</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
