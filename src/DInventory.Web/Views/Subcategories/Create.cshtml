@model DInventory.Domain.Entities.Subcategory
@{
    ViewData["Title"] = "New Subcategory";
    bool canCreate = ViewBag.CanCreate ?? false;
}
<div class="card shadow-sm">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        @if (!canCreate)
        {
            <div class="alert alert-warning">
                Select a company from the <strong>Company</strong> dropdown in the top navigation bar before creating a subcategory - "All Companies" can't own one.
            </div>
        }
        <form method="post">
            <input asp-for="CompanyId" type="hidden" />
            <div class="mb-3">
                <label class="form-label">Category</label>
                <select asp-for="CategoryId" class="form-select" asp-items="@(new SelectList(ViewBag.Categories, "CategoryId", "CategoryName"))" required></select>
            </div>
            <div class="mb-3">
                <label class="form-label">Subcategory Name</label>
                <input asp-for="SubcategoryName" class="form-control" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Description</label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
            </div>
            <button type="submit" class="btn btn-primary" disabled="@(!canCreate)">Create Subcategory</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
