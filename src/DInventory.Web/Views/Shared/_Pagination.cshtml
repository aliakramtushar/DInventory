@*
    Reusable Bootstrap pagination partial for PagedResult<T> list views.

    Usage from a view:
        @await Html.PartialAsync("_Pagination", new PaginationViewModel
        {
            PageNumber = Model.PageNumber,
            TotalPages = Model.TotalPages,
            HasPreviousPage = Model.HasPreviousPage,
            HasNextPage = Model.HasNextPage,
            RouteValues = PaginationViewModel.Filters(
                ("search", ViewData["Search"]?.ToString()),
                ("categoryId", ViewData["CategoryId"]?.ToString()))
        })

    Renders nothing when there is only one page (or zero results).
*@
@model DInventory.Web.Models.PaginationViewModel
@{
    var actionName = Model.ActionName ?? ViewContext.RouteData.Values["action"]?.ToString();
    var controllerName = Model.ControllerName ?? ViewContext.RouteData.Values["controller"]?.ToString();

    // Bootstrap only ever renders a small window of page links around the current page so the
    // control stays usable even with a large TotalPages.
    const int window = 2;
    var startPage = Math.Max(1, Model.PageNumber - window);
    var endPage = Math.Min(Model.TotalPages, Model.PageNumber + window);

    // asp-route-{name} and asp-all-route-data both bind to the AnchorTagHelper's SAME underlying
    // RouteValues dictionary (confirmed in AnchorTagHelper.cs: both attributes target one
    // IDictionary<string,string> property, "asp-all-route-data" via a plain setter that REPLACES
    // the dictionary outright, "asp-route-{name}" via the indexer that mutates it in place).
    // Combining both on one tag makes whichever is written LAST in the markup win completely, not
    // merge - every link below used to write asp-route-page first and asp-all-route-data second,
    // so the plain assignment from asp-all-route-data silently wiped out the page number every
    // time, and every pagination link ended up pointing at the same (page-less) URL. Building one
    // complete per-link dictionary here and using only asp-all-route-data avoids the conflict
    // entirely - see https://github.com/dotnet/aspnetcore/issues/57701.
    Dictionary<string, string> RouteValuesFor(int page) =>
        new Dictionary<string, string>(Model.RouteValues) { ["page"] = page.ToString() };
}
@if (Model.TotalPages > 1)
{
    var rangeStart = ((Model.PageNumber - 1) * Model.PageSize) + 1;
    var rangeEnd = Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount);
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
        <div class="small text-muted">
            Showing @rangeStart&ndash;@rangeEnd of @Model.TotalCount
        </div>
    </div>
    <nav aria-label="Page navigation">
        <ul class="pagination pagination-sm mb-0 flex-wrap">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" asp-action="@actionName" asp-controller="@controllerName"
                   asp-all-route-data="RouteValuesFor(1)">
                    <i class="bi bi-chevron-double-left"></i>
                </a>
            </li>
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" asp-action="@actionName" asp-controller="@controllerName"
                   asp-all-route-data="RouteValuesFor(Model.PageNumber - 1)">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>

            @if (startPage > 1)
            {
                <li class="page-item disabled d-none d-sm-block"><span class="page-link">&hellip;</span></li>
            }

            @for (var pageNumber = startPage; pageNumber <= endPage; pageNumber++)
            {
                <li class="page-item @(pageNumber == Model.PageNumber ? "active" : "")">
                    <a class="page-link" asp-action="@actionName" asp-controller="@controllerName"
                       asp-all-route-data="RouteValuesFor(pageNumber)">@pageNumber</a>
                </li>
            }

            @if (endPage < Model.TotalPages)
            {
                <li class="page-item disabled d-none d-sm-block"><span class="page-link">&hellip;</span></li>
            }

            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" asp-action="@actionName" asp-controller="@controllerName"
                   asp-all-route-data="RouteValuesFor(Model.PageNumber + 1)">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" asp-action="@actionName" asp-controller="@controllerName"
                   asp-all-route-data="RouteValuesFor(Model.TotalPages)">
                    <i class="bi bi-chevron-double-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}
