@*
    Reusable Bootstrap pagination partial for PagedResult<T> list views.

    Usage from a view:
        @await Html.PartialAsync("_Pagination", new PaginationViewModel
        {
            PageNumber = Model.PageNumber,
            TotalPages = Model.TotalPages,
            HasPreviousPage = Model.HasPreviousPage,
            HasNextPage = Model.HasNextPage,
            RouteValues = PaginationViewModel.Filters(
                ("search", ViewData["Search"]?.ToString()),
                ("categoryId", ViewData["CategoryId"]?.ToString()))
        })

    Renders nothing when there is only one page (or zero results).
*@
@model DInventory.Web.Models.PaginationViewModel
@{
    var actionName = Model.ActionName ?? ViewContext.RouteData.Values["action"]?.ToString();
    var controllerName = Model.ControllerName ?? ViewContext.RouteData.Values["controller"]?.ToString();

    // Bootstrap only ever renders a small window of page links around the current page so the
    // control stays usable even with a large TotalPages.
    const int window = 2;
    var startPage = Math.Max(1, Model.PageNumber - window);
    var endPage = Math.Min(Model.TotalPages, Model.PageNumber + window);
}
@if (Model.TotalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination pagination-sm mb-0 flex-wrap">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" asp-action="@actionName" asp-controller="@controllerName"
                   asp-route-page="1"
                   asp-all-route-data="Model.RouteValues">
                    <i class="bi bi-chevron-double-left"></i>
                </a>
            </li>
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" asp-action="@actionName" asp-controller="@controllerName"
                   asp-route-page="@(Model.PageNumber - 1)"
                   asp-all-route-data="Model.RouteValues">
                    <i class="bi bi-chevron-left"></i>
                </a>
            </li>

            @if (startPage > 1)
            {
                <li class="page-item disabled d-none d-sm-block"><span class="page-link">&hellip;</span></li>
            }

            @for (var pageNumber = startPage; pageNumber <= endPage; pageNumber++)
            {
                <li class="page-item @(pageNumber == Model.PageNumber ? "active" : "")">
                    <a class="page-link" asp-action="@actionName" asp-controller="@controllerName"
                       asp-route-page="@pageNumber"
                       asp-all-route-data="Model.RouteValues">@pageNumber</a>
                </li>
            }

            @if (endPage < Model.TotalPages)
            {
                <li class="page-item disabled d-none d-sm-block"><span class="page-link">&hellip;</span></li>
            }

            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" asp-action="@actionName" asp-controller="@controllerName"
                   asp-route-page="@(Model.PageNumber + 1)"
                   asp-all-route-data="Model.RouteValues">
                    <i class="bi bi-chevron-right"></i>
                </a>
            </li>
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" asp-action="@actionName" asp-controller="@controllerName"
                   asp-route-page="@Model.TotalPages"
                   asp-all-route-data="Model.RouteValues">
                    <i class="bi bi-chevron-double-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}
