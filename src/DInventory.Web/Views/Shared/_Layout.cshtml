<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - DInventory</title>
    <link rel="stylesheet" href="~/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bootstrap-icons.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head> 
<body>
    @* Anti-flash: apply the persisted sidebar-collapsed state before the shell below ever paints.
       This has to be a plain synchronous inline script (not site.js, which loads at the bottom of
       the page) - by the time an external, deferred-by-position script at the end of <body> would
       run, the sidebar has already been visible full-width for a moment, causing a visible "snap"
       on every page load for anyone who collapsed it. Running inline, before .erp-shell is parsed,
       means the class is already present the instant the shell paints. *@
    <script>
        (function () {
            if (window.localStorage && localStorage.getItem('dinv-sidebar-collapsed') === 'true') {
                document.body.classList.add('dinv-sidebar-collapsed');
            }
        })();
    </script>
    <div class="erp-shell">
        <aside class="erp-sidebar" id="erpSidebar">
            <div class="erp-brand">
                <i class="bi bi-boxes"></i>
                <span>DInventory</span>
            </div>
            <div class="erp-sidebar-search">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" id="sidebarMenuSearch" class="form-control" placeholder="Search menu..." autocomplete="off" aria-label="Search menu" />
                </div>
            </div>
            <nav class="erp-nav">
                @await Component.InvokeAsync("SidebarMenu")
                <div class="erp-nav-empty" id="sidebarMenuNoResults" style="display:none;">
                    <i class="bi bi-search"></i> No matching menu items.
                </div>
            </nav>
        </aside>

        <div class="erp-main">
            <header class="erp-topbar">
                <button class="btn btn-sm btn-outline-secondary d-lg-none" id="sidebarToggle" type="button">
                    <i class="bi bi-list"></i>
                </button>
                <button class="btn btn-sm btn-outline-secondary d-none d-lg-inline-flex" id="sidebarCollapseToggle" type="button" title="Collapse sidebar">
                    <i class="bi bi-layout-sidebar-inset"></i>
                </button>
                <div class="erp-topbar-title">@ViewData["Title"]</div>
                <div class="erp-topbar-actions">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @await Component.InvokeAsync("CompanySelector")
                        @await Component.InvokeAsync("BusinessUnitSelector")
                        <div class="dropdown">
                            <button class="btn btn-light dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle fs-5"></i>
                                <span class="d-none d-sm-inline">@User.FindFirst("fullName")?.Value</span>
                                <span class="badge text-bg-primary">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword"><i class="bi bi-key me-2"></i>Change Password</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i>Logout</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Login"><i class="bi bi-box-arrow-in-right me-1"></i>Login</a>
                    }
                </div>
            </header>

            <main class="erp-content">
                @if (TempData["StatusMessage"] is string statusMessage && !string.IsNullOrWhiteSpace(statusMessage))
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @statusMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] is string errorMessage && !string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @errorMessage
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
