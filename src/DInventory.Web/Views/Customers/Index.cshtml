@model DInventory.Application.Common.Models.PagedResult<DInventory.Domain.Entities.Customer>
@{
    ViewData["Title"] = "Customers";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <form class="d-flex gap-2" method="get">
        <input type="text" name="search" value="@ViewData["Search"]" class="form-control form-control-sm" placeholder="Search customers..." />
        <button class="btn btn-sm btn-outline-secondary" type="submit"><i class="bi bi-search"></i></button>
    </form>
    <div class="d-flex gap-2">
        <a asp-action="LoyaltySettings" class="btn btn-outline-secondary btn-sm"><i class="bi bi-gear me-1"></i>Loyalty Settings</a>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>New Customer</a>
    </div>
</div>
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Name</th><th>Mobile</th><th>Email</th><th>Address</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No customers found.</td></tr>
                }
                @foreach (var customer in Model.Items)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@customer.CustomerId">@customer.CustomerName</a></td>
                        <td>@customer.Phone</td>
                        <td class="small">@customer.Email</td>
                        <td class="text-muted small">@customer.Address</td>
                        <td>@(customer.IsActive ? "Active" : "Inactive")</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@customer.CustomerId"><i class="bi bi-eye"></i></a>
                                <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@customer.CustomerId"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Delete" asp-route-id="@customer.CustomerId" method="post" class="d-inline" onsubmit="return confirm('Delete this customer?');">
                                    <button class="btn btn-outline-danger" type="submit"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white">
            @await Html.PartialAsync("_Pagination", new PaginationViewModel
            {
                PageNumber = Model.PageNumber,
                TotalCount = Model.TotalCount,
                PageSize = Model.PageSize,
                TotalPages = Model.TotalPages,
                HasPreviousPage = Model.HasPreviousPage,
                HasNextPage = Model.HasNextPage,
                RouteValues = PaginationViewModel.Filters(("search", ViewData["Search"]?.ToString()))
            })
        </div>
    }
</div>
