@model IEnumerable<DInventory.Application.Common.Models.StockReportRow>
@{
    ViewData["Title"] = "Stock Report";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Stock Valuation Report</h5>
    <a asp-action="StockExport" class="btn btn-outline-success btn-sm"><i class="bi bi-file-earmark-spreadsheet me-1"></i>Export CSV</a>
</div>
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Code</th><th>Product</th><th>Category</th><th class="text-end">Qty</th><th class="text-end">Reorder</th><th class="text-end">Cost</th><th class="text-end">Selling</th><th class="text-end">Stock Value</th><th>Last Sold</th></tr></thead>
            <tbody>
                @{ decimal totalValue = 0; }
                @foreach (var row in Model)
                {
                    totalValue += row.StockValue;
                    <tr class="@(row.IsLowStock ? "table-danger" : "")">
                        <td><code>@row.ProductCode</code></td>
                        <td>@row.ProductName</td>
                        <td>@row.CategoryName</td>
                        <td class="text-end">@row.QuantityOnHand</td>
                        <td class="text-end">@row.ReorderLevel</td>
                        <td class="text-end">@((row.CostPrice ?? 0).ToMoney())</td>
                        <td class="text-end">@((row.SellingPrice ?? 0).ToMoney())</td>
                        <td class="text-end">@row.StockValue.ToMoney()</td>
                        <td class="small">
                            @if (row.IsDeadStock)
                            {
                                <span class="badge text-bg-warning text-dark">Dead Stock</span>
                            }
                            <div class="text-muted">@(row.LastSoldAt.HasValue ? row.LastSoldAt.Value.ToString("d") : "Never sold")</div>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="fw-bold"><td colspan="7" class="text-end">Total Stock Value</td><td class="text-end">@totalValue.ToMoney()</td><td></td></tr>
            </tfoot>
        </table>
    </div>
</div>
