@model IEnumerable<DInventory.Application.Common.Models.MenuPermissionDto>
@{
    var role = (DInventory.Domain.Entities.Role)ViewBag.Role;
    ViewData["Title"] = $"Permissions - {role.RoleName}";
    var list = Model.ToList();
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">Menu Permissions for <span class="text-primary">@role.RoleName</span></h5>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Roles</a>
</div>

@if (role.IsSystemRole)
{
    <div class="alert alert-info">This is a system role and already has full access to every menu.</div>
}

<form asp-action="Permissions" asp-route-id="@role.RoleId" method="post">
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Menu</th>
                        <th class="text-center">View</th>
                        <th class="text-center">Create</th>
                        <th class="text-center">Edit</th>
                        <th class="text-center">Delete</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < list.Count; i++)
                    {
                        var menu = list[i];
                        <tr>
                            <td>
                                <i class="bi @(string.IsNullOrWhiteSpace(menu.Icon) ? "bi-dot" : menu.Icon) me-1"></i>
                                @menu.MenuName
                                <input type="hidden" name="items[@i].MenuId" value="@menu.MenuId" />
                            </td>
                            <td class="text-center"><input type="checkbox" class="form-check-input" name="items[@i].CanView" value="true" checked="@menu.CanView" /></td>
                            <td class="text-center"><input type="checkbox" class="form-check-input" name="items[@i].CanCreate" value="true" checked="@menu.CanCreate" /></td>
                            <td class="text-center"><input type="checkbox" class="form-check-input" name="items[@i].CanEdit" value="true" checked="@menu.CanEdit" /></td>
                            <td class="text-center"><input type="checkbox" class="form-check-input" name="items[@i].CanDelete" value="true" checked="@menu.CanDelete" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Save Permissions</button>
    </div>
</form>
