@model DInventory.Application.Common.Models.PagedResult<DInventory.Domain.Entities.Purchase>
@{
    ViewData["Title"] = "Purchases";
    var suppliers = (IEnumerable<DInventory.Domain.Entities.Supplier>)ViewBag.Suppliers;
}
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <form class="d-flex gap-2 flex-wrap" method="get">
        <select name="businessUnitId" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">All Business Units</option>
            @foreach (var bu in (IEnumerable<DInventory.Domain.Entities.BusinessUnit>)ViewBag.BusinessUnits)
            {
                <option value="@bu.BusinessUnitId" selected="@(ViewData["BusinessUnitId"]?.ToString() == bu.BusinessUnitId.ToString())">@bu.BusinessUnitName</option>
            }
        </select>
        <select name="supplierId" class="form-select form-select-sm" onchange="this.form.submit()">
            <option value="">All Suppliers</option>
            @foreach (var s in suppliers)
            {
                <option value="@s.SupplierId" selected="@(ViewData["SupplierId"] != null && (int)ViewData["SupplierId"]! == s.SupplierId)">@s.SupplierName</option>
            }
        </select>
    </form>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>New Purchase</a>
</div>
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Invoice No</th>@if ((bool)ViewBag.IsSuperCompany){<th>Company</th>}<th>Supplier</th><th>Date</th><th class="text-end">Total</th><th class="text-end">Paid</th><th class="text-end">Due</th><th></th></tr></thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No purchases found.</td></tr>
                }
                @foreach (var purchase in Model.Items)
                {
                    <tr>
                        <td>@purchase.PurchaseInvoiceNo</td>
                        @if ((bool)ViewBag.IsSuperCompany)
                        {
                            <td class="small text-muted">@purchase.CompanyName</td>
                        }
                        <td>@purchase.SupplierName</td>
                        <td class="small">@purchase.PurchaseDate.ToString("g")</td>
                        <td class="text-end">@purchase.TotalAmount.ToMoney()</td>
                        <td class="text-end">@purchase.PaidAmount.ToMoney()</td>
                        <td class="text-end @(purchase.DueAmount > 0 ? "text-danger" : "")">@purchase.DueAmount.ToMoney()</td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@purchase.PurchaseId"><i class="bi bi-eye"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white">
            @await Html.PartialAsync("_Pagination", new PaginationViewModel
            {
                PageNumber = Model.PageNumber,
                TotalCount = Model.TotalCount,
                PageSize = Model.PageSize,
                TotalPages = Model.TotalPages,
                HasPreviousPage = Model.HasPreviousPage,
                HasNextPage = Model.HasNextPage,
                RouteValues = PaginationViewModel.Filters(
                    ("supplierId", ViewData["SupplierId"]?.ToString()),
                    ("businessUnitId", ViewData["BusinessUnitId"]?.ToString()))
            })
        </div>
    }
</div>
