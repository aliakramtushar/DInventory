@model DInventory.Domain.Entities.Purchase
@{
    ViewData["Title"] = $"Purchase {Model.PurchaseInvoiceNo}";
}
<div class="card shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between">
            <div>
                @if (!string.IsNullOrWhiteSpace(Model.CompanyName))
                {
                    <h6 class="text-uppercase text-muted mb-1">@Model.CompanyName</h6>
                }
                <h4>Purchase @Model.PurchaseInvoiceNo</h4>
                <p class="text-muted mb-0">@Model.PurchaseDate.ToString("f")</p>
                <p class="text-muted">
                    Supplier: <a asp-controller="Suppliers" asp-action="Details" asp-route-id="@Model.SupplierId">@Model.SupplierName</a>
                    &middot; Received by: @Model.CreatedByName
                </p>
            </div>
        </div>
        <table class="table mt-3">
            <thead class="table-light"><tr><th>Product</th><th>Size</th><th>Color</th><th>Barcode</th><th>Qty</th><th>Buying Price</th><th class="text-end">Line Total</th></tr></thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.ProductName <span class="text-muted small">(@item.ProductCode)</span></td>
                        <td><span class="badge text-bg-light text-dark">@item.SizeName</span></td>
                        <td>@(item.ColorName ?? "-")</td>
                        <td class="small"><code>@item.Barcode</code></td>
                        <td>@item.Quantity</td>
                        <td>@item.BuyingPrice.ToMoney()</td>
                        <td class="text-end">@item.LineTotal.ToMoney()</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="fw-bold"><td colspan="6" class="text-end">Total Amount</td><td class="text-end">@Model.TotalAmount.ToMoney()</td></tr>
                <tr><td colspan="6" class="text-end">Paid Amount</td><td class="text-end">@Model.PaidAmount.ToMoney()</td></tr>
                @if (Model.ReturnedAmount > 0)
                {
                    <tr class="text-danger"><td colspan="6" class="text-end">Returned</td><td class="text-end">-@Model.ReturnedAmount.ToMoney()</td></tr>
                }
                <tr class="@(Model.DueAmount > 0 ? "text-danger fw-bold" : "")"><td colspan="6" class="text-end">Due</td><td class="text-end">@Model.DueAmount.ToMoney()</td></tr>
            </tfoot>
        </table>
        @if (!string.IsNullOrWhiteSpace(Model.Remarks))
        {
            <p class="text-muted">Remarks: @Model.Remarks</p>
        }
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Purchases</a>
        <a asp-controller="PurchaseReturns" asp-action="Create" asp-route-invoiceNo="@Model.PurchaseInvoiceNo" class="btn btn-outline-warning btn-sm no-print"><i class="bi bi-arrow-return-right"></i> Return Items</a>
        <button onclick="window.print()" class="btn btn-outline-primary btn-sm no-print"><i class="bi bi-printer"></i> Print</button>
        <button type="button" onclick="printPosReceipt()" class="btn btn-outline-secondary btn-sm no-print"><i class="bi bi-receipt-cutoff"></i> Print Receipt (POS)</button>
    </div>
</div>

<div id="posReceiptAnchor">
    <div id="posReceipt" class="d-none" style="width: 80mm; font-family: 'Courier New', monospace; font-size: 12px; margin: 0 auto;">
        <div class="text-center">
            @if (!string.IsNullOrWhiteSpace(Model.CompanyName))
            {
                <div style="font-weight:bold; font-size: 14px;">@Model.CompanyName</div>
            }
            <div>Purchase: @Model.PurchaseInvoiceNo</div>
            <div>@Model.PurchaseDate.ToString("g")</div>
        </div>
        <div style="border-top: 1px dashed #000; margin: 4px 0;"></div>
        <div>Supplier: @Model.SupplierName</div>
        <div>Received by: @Model.CreatedByName</div>
        <div style="border-top: 1px dashed #000; margin: 4px 0;"></div>
        @foreach (var item in Model.Items)
        {
            <div style="display:flex; justify-content:space-between;">
                <span>@item.ProductName (@item.SizeName) x@item.Quantity</span>
                <span>@item.LineTotal.ToMoney()</span>
            </div>
        }
        <div style="border-top: 1px dashed #000; margin: 4px 0;"></div>
        <div style="display:flex; justify-content:space-between; font-weight:bold;"><span>Total Amount</span><span>@Model.TotalAmount.ToMoney()</span></div>
        <div style="display:flex; justify-content:space-between;"><span>Paid Amount</span><span>@Model.PaidAmount.ToMoney()</span></div>
        @if (Model.ReturnedAmount > 0)
        {
            <div style="display:flex; justify-content:space-between;"><span>Returned</span><span>-@Model.ReturnedAmount.ToMoney()</span></div>
        }
        <div style="display:flex; justify-content:space-between;"><span>Due</span><span>@Model.DueAmount.ToMoney()</span></div>
        <div style="border-top: 1px dashed #000; margin: 4px 0;"></div>
        <div class="text-center">-- End of Receipt --</div>
    </div>
</div>

@section Scripts {
<script>
    function printPosReceipt() {
        const receipt = document.getElementById('posReceipt');
        const style = document.createElement('style');
        style.id = 'posPrintStyle';
        style.innerHTML = '@@media print { body > *:not(#posReceipt) { display: none !important; } #posReceipt { display: block !important; } @@page { size: 80mm auto; margin: 2mm; } }';
        document.head.appendChild(style);
        document.body.appendChild(receipt);
        receipt.classList.remove('d-none');
        window.print();
    }

    window.addEventListener('afterprint', () => {
        const style = document.getElementById('posPrintStyle');
        if (style) { style.remove(); }
        const receipt = document.getElementById('posReceipt');
        const anchor = document.getElementById('posReceiptAnchor');
        if (receipt && anchor) {
            receipt.classList.add('d-none');
            anchor.appendChild(receipt);
        }
    });
</script>
}
