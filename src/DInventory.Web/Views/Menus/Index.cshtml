@model DInventory.Application.Common.Models.PagedResult<DInventory.Domain.Entities.Menu>
@{
    ViewData["Title"] = "Menus";
    var parentNames = (Dictionary<int, string>)ViewBag.ParentNames;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <form class="d-flex gap-2" method="get">
        <input type="text" name="search" value="@ViewData["Search"]" class="form-control form-control-sm" placeholder="Search menus..." />
        <button class="btn btn-sm btn-outline-secondary" type="submit"><i class="bi bi-search"></i></button>
    </form>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>New Menu</a>
</div>
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Icon</th><th>Menu Key</th><th>Name</th><th>Parent Group</th><th>Url</th><th>Order</th><th>Status</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No menus found.</td></tr>
                }
                @* Ordering is entirely backend-driven (see MenuRepository.GetPagedAsync's ORDER BY) -
                   never re-sort the already-paginated page here, or item order could look inconsistent
                   with what the pager's page numbers actually mean. *@
                @foreach (var menu in Model.Items)
                {
                    <tr>
                        <td><i class="bi @(menu.Icon ?? "bi-dot")"></i></td>
                        <td><code>@menu.MenuKey</code></td>
                        <td>@menu.MenuName</td>
                        <td class="small text-muted">@(menu.ParentId.HasValue && parentNames.TryGetValue(menu.ParentId.Value, out var parentName) ? parentName : "-")</td>
                        <td class="text-muted small">@menu.Url</td>
                        <td>@menu.DisplayOrder</td>
                        <td>@(menu.IsActive ? "Active" : "Inactive")</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@menu.MenuId"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Delete" asp-route-id="@menu.MenuId" method="post" class="d-inline" onsubmit="return confirm('Delete this menu?');">
                                    <button class="btn btn-outline-danger" type="submit"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white">
            @await Html.PartialAsync("_Pagination", new PaginationViewModel
            {
                PageNumber = Model.PageNumber,
                TotalCount = Model.TotalCount,
                PageSize = Model.PageSize,
                TotalPages = Model.TotalPages,
                HasPreviousPage = Model.HasPreviousPage,
                HasNextPage = Model.HasNextPage,
                RouteValues = PaginationViewModel.Filters(("search", ViewData["Search"]?.ToString()))
            })
        </div>
    }
</div>
