@model DInventory.Domain.Entities.Supplier
@{
    ViewData["Title"] = "New Supplier";
    bool canCreate = ViewBag.CanCreate ?? false;
}
<div class="card shadow-sm">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        @if (!canCreate)
        {
            <div class="alert alert-warning">
                Select a company from the <strong>Company</strong> dropdown in the top navigation bar before creating a supplier - "All Companies" can't own one.
            </div>
        }
        <form method="post">
            <input asp-for="CompanyId" type="hidden" />
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Supplier Name</label>
                    <input asp-for="SupplierName" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Phone</label>
                    <input asp-for="Phone" class="form-control" />
                </div>
                <div class="col-12">
                    <label class="form-label">Address</label>
                    <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary" disabled="@(!canCreate)">Create Supplier</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
