@model DInventory.Domain.Entities.SalesOrder
@{
    ViewData["Title"] = $"Invoice {Model.InvoiceNo}";
}
<div class="card shadow-sm">
    <div class="card-body">
        <div class="d-flex justify-content-between">
            <div>
                @if (!string.IsNullOrWhiteSpace(Model.CompanyName))
                {
                    <h6 class="text-uppercase text-muted mb-1">@Model.CompanyName</h6>
                }
                <h4>Invoice @Model.InvoiceNo</h4>
                <p class="text-muted mb-0">@Model.SaleDate.ToString("f")</p>
                <p class="text-muted">
                    Customer:
                    @if (Model.CustomerId.HasValue)
                    {
                        <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId">@(Model.CustomerName ?? "Walk-in")</a>
                    }
                    else
                    {
                        @:Walk-in
                    }
                    &middot; Served by: @Model.CreatedByName
                </p>
            </div>
            <div class="text-end">
                <span class="badge fs-6 @(Model.Status == "COMPLETED" ? "text-bg-success" : "text-bg-danger")">@Model.Status</span>
            </div>
        </div>
        <table class="table mt-3">
            <thead class="table-light"><tr><th>Product</th><th>Size</th><th>Barcode</th><th>Qty</th><th>Unit Price</th><th>Discount</th><th class="text-end">Line Total</th></tr></thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>@item.ProductName <span class="text-muted small">(@item.ProductCode)</span></td>
                        <td><span class="badge text-bg-light text-dark">@item.SizeName</span></td>
                        <td class="small"><code>@item.Barcode</code></td>
                        <td>
                            @item.Quantity
                            @if (item.ReturnedQuantity > 0)
                            {
                                <span class="badge text-bg-warning text-dark ms-1" title="Already returned">-@item.ReturnedQuantity ret.</span>
                            }
                        </td>
                        <td>@item.UnitPrice.ToMoney()</td>
                        <td class="small text-muted">
                            @if (item.DiscountAmount > 0)
                            {
                                @(item.DiscountType == "PERCENT" ? $"{item.DiscountValue:0.##}%" : item.DiscountAmount.ToMoney())
                            }
                            else
                            {
                                @:-
                            }
                        </td>
                        <td class="text-end">@item.LineTotal.ToMoney()</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr><td colspan="6" class="text-end">Subtotal</td><td class="text-end">@Model.SubTotal.ToMoney()</td></tr>
                <tr><td colspan="6" class="text-end">Discount @(Model.DiscountType == "PERCENT" && Model.DiscountValue > 0 ? $"(incl. {Model.DiscountValue:0.##}% on bill)" : "")</td><td class="text-end">-@Model.DiscountAmount.ToMoney()</td></tr>
                <tr><td colspan="6" class="text-end">Tax</td><td class="text-end">@Model.TaxAmount.ToMoney()</td></tr>
                <tr class="fw-bold"><td colspan="6" class="text-end">Net Total</td><td class="text-end">@Model.NetAmount.ToMoney()</td></tr>
                @if (Model.LoyaltyPointsRedeemed > 0)
                {
                    <tr class="small text-muted"><td colspan="6" class="text-end">(incl. @Model.LoyaltyPointsRedeemed loyalty point(s) redeemed)</td><td class="text-end">-@Model.LoyaltyRedeemAmount.ToMoney()</td></tr>
                }
                @if (Model.LoyaltyPointsEarned > 0)
                {
                    <tr class="small text-success"><td colspan="6" class="text-end">Loyalty points earned</td><td class="text-end">+@Model.LoyaltyPointsEarned</td></tr>
                }
                @if (Model.ReturnedAmount > 0)
                {
                    <tr class="text-danger"><td colspan="6" class="text-end">Returned</td><td class="text-end">-@Model.ReturnedAmount.ToMoney()</td></tr>
                    <tr class="fw-bold"><td colspan="6" class="text-end">Net After Returns</td><td class="text-end">@((Model.NetAmount - Model.ReturnedAmount).ToMoney())</td></tr>
                }
            </tfoot>
        </table>
        <div class="mt-2">
            <span class="badge text-bg-light text-dark border">Payment: @Model.PaymentMethod</span>
        </div>
        @if (!string.IsNullOrWhiteSpace(Model.Remarks))
        {
            <p class="text-muted">Remarks: @Model.Remarks</p>
        }
        <div class="no-print">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Sales</a>
            @if (Model.Status == "COMPLETED")
            {
                <a asp-controller="SalesReturns" asp-action="Create" asp-route-invoiceNo="@Model.InvoiceNo" class="btn btn-outline-warning btn-sm"><i class="bi bi-arrow-return-left"></i> Return Items</a>
                <form asp-action="Cancel" asp-route-id="@Model.SalesOrderId" method="post" class="d-inline" onsubmit="return confirm('Cancel this sale and return stock?');">
                    <button type="submit" class="btn btn-outline-danger btn-sm">Cancel Sale</button>
                </form>
            }
            <button onclick="window.print()" class="btn btn-outline-primary btn-sm"><i class="bi bi-printer"></i> Print Invoice</button>
            <button type="button" onclick="printPosReceipt()" class="btn btn-outline-secondary btn-sm"><i class="bi bi-receipt-cutoff"></i> Print Receipt (POS)</button>
        </div>
    </div>
</div>

<div id="posReceiptAnchor">
    <div id="posReceipt" class="d-none" style="width: 80mm; font-family: 'Courier New', monospace; font-size: 12px; margin: 0 auto;">
        <div class="text-center">
            @if (!string.IsNullOrWhiteSpace(Model.CompanyName))
            {
                <div style="font-weight:bold; font-size: 14px;">@Model.CompanyName</div>
            }
            <div>Invoice: @Model.InvoiceNo</div>
            <div>@Model.SaleDate.ToString("g")</div>
        </div>
        <div style="border-top: 1px dashed #000; margin: 4px 0;"></div>
        <div>Customer: @(Model.CustomerName ?? "Walk-in")</div>
        <div>Served by: @Model.CreatedByName</div>
        <div style="border-top: 1px dashed #000; margin: 4px 0;"></div>
        @foreach (var item in Model.Items)
        {
            <div style="display:flex; justify-content:space-between;">
                <span>@item.ProductName (@item.SizeName) x@item.Quantity</span>
                <span>@item.LineTotal.ToMoney()</span>
            </div>
        }
        <div style="border-top: 1px dashed #000; margin: 4px 0;"></div>
        <div style="display:flex; justify-content:space-between;"><span>Subtotal</span><span>@Model.SubTotal.ToMoney()</span></div>
        @if (Model.DiscountAmount > 0)
        {
            <div style="display:flex; justify-content:space-between;"><span>Discount</span><span>-@Model.DiscountAmount.ToMoney()</span></div>
        }
        @if (Model.TaxAmount > 0)
        {
            <div style="display:flex; justify-content:space-between;"><span>Tax</span><span>@Model.TaxAmount.ToMoney()</span></div>
        }
        <div style="display:flex; justify-content:space-between; font-weight:bold;"><span>Net Total</span><span>@Model.NetAmount.ToMoney()</span></div>
        @if (Model.ReturnedAmount > 0)
        {
            <div style="display:flex; justify-content:space-between;"><span>Returned</span><span>-@Model.ReturnedAmount.ToMoney()</span></div>
        }
        <div style="border-top: 1px dashed #000; margin: 4px 0;"></div>
        <div>Payment: @Model.PaymentMethod</div>
        <div style="border-top: 1px dashed #000; margin: 4px 0;"></div>
        <div class="text-center">Thank you!</div>
    </div>
</div>

@section Scripts {
<script>
    function printPosReceipt() {
        const receipt = document.getElementById('posReceipt');
        const style = document.createElement('style');
        style.id = 'posPrintStyle';
        style.innerHTML = '@@media print { body > *:not(#posReceipt) { display: none !important; } #posReceipt { display: block !important; } @@page { size: 80mm auto; margin: 2mm; } }';
        document.head.appendChild(style);
        document.body.appendChild(receipt);
        receipt.classList.remove('d-none');
        window.print();
    }

    window.addEventListener('afterprint', () => {
        const style = document.getElementById('posPrintStyle');
        if (style) { style.remove(); }
        const receipt = document.getElementById('posReceipt');
        const anchor = document.getElementById('posReceiptAnchor');
        if (receipt && anchor) {
            receipt.classList.add('d-none');
            anchor.appendChild(receipt);
        }
    });
</script>
}
