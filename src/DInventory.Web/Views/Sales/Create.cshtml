@{
    ViewData["Title"] = "New Sale";
    var variants = (IEnumerable<DInventory.Domain.Entities.ProductVariant>)ViewBag.Variants;
    var customers = (IEnumerable<DInventory.Domain.Entities.Customer>)ViewBag.Customers;
}
<div class="row g-3">
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
                <span>Scan to Add</span>
                <span id="scanStatusBadge" class="badge text-bg-light text-dark">Ready to scan</span>
            </div>
            <div class="card-body">
                <div id="scanError" class="alert alert-danger d-none py-2"></div>
                <div class="input-group mb-3">
                    <span class="input-group-text"><i class="bi bi-upc-scan"></i></span>
                    <input id="scanInput" class="form-control form-control-lg barcode-scan-input" placeholder="Scan barcode here..." autofocus />
                </div>
                <p class="text-muted small mb-4">
                    Point the scanner at the item's barcode - it will be added to the cart automatically with quantity 1.
                    The scan box refocuses itself after every scan, but you're free to click into the customer,
                    discount, tax, or quantity fields at any other time - it won't steal focus back from you.
                </p>

                <hr />
                <h6 class="text-muted text-uppercase small mb-2">Manual product/size picker (fallback)</h6>
                <div class="row g-2 mb-3">
                    <div class="col-8">
                        <select id="variantSelect" class="form-select">
                            <option value="">-- Select a product/size --</option>
                            @foreach (var v in variants)
                            {
                                <option value="@v.ProductVariantId" data-price="@v.SellingPrice" data-stock="@v.QuantityOnHand"
                                        data-name="@v.ProductName" data-size="@v.SizeName" data-barcode="@v.Barcode">
                                    @v.ProductName (@v.SizeName) &mdash; @(v.QuantityOnHand ?? 0) in stock
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-2">
                        <input id="variantQty" type="number" min="1" value="1" class="form-control" />
                    </div>
                    <div class="col-2">
                        <button type="button" id="addVariantBtn" class="btn btn-primary w-100">Add</button>
                    </div>
                </div>

                <table class="table table-sm align-middle">
                    <thead class="table-light"><tr><th>Product</th><th>Size</th><th style="width:80px">Qty</th><th>Price</th><th style="width:150px">Discount</th><th>Total</th><th></th></tr></thead>
                    <tbody id="cartBody">
                        <tr id="emptyRow"><td colspan="7" class="text-muted text-center">No items added yet.</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-header bg-white fw-semibold">Checkout</div>
            <div class="card-body">
                <form asp-action="Create" method="post" id="saleForm">
                    <input type="hidden" name="itemsJson" id="itemsJson" value="[]" />
                    <div class="mb-3">
                        <label class="form-label">Customer</label>
                        <select name="customerId" id="customerIdSelect" class="form-select">
                            <option value="">-- Walk-in customer --</option>
                            @foreach (var c in customers)
                            {
                                <option value="@c.CustomerId">@c.CustomerName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Or new customer name</label>
                        <input name="newCustomerName" id="newCustomerNameInput" class="form-control" placeholder="Optional" />
                    </div>
                    <div id="loyaltyBox" class="mb-3 d-none">
                        <label class="form-label">Redeem Loyalty Points <span id="loyaltyBalanceLabel" class="text-muted small"></span></label>
                        <input type="number" id="redeemPointsInput" name="redeemPoints" min="0" value="0" class="form-control" />
                        <div class="form-text" id="redeemValueHint"></div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-7">
                            <label class="form-label">Bill Discount</label>
                            <div class="input-group">
                                <select name="discountType" id="discountType" class="form-select" style="max-width:90px">
                                    <option value="FIXED" selected>Amt</option>
                                    <option value="PERCENT">%</option>
                                </select>
                                <input name="discountValue" id="discountValue" type="number" step="0.01" min="0" value="0" class="form-control" />
                            </div>
                        </div>
                        <div class="col-5">
                            <label class="form-label">Tax</label>
                            <input name="taxAmount" id="taxAmount" type="number" step="0.01" min="0" value="0" class="form-control" />
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label">Payment Status</label>
                            <select name="paymentStatus" class="form-select">
                                <option value="PAID">Paid</option>
                                <option value="DUE">Due</option>
                                <option value="PARTIAL">Partial</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label">Payment Method</label>
                            <select name="paymentMethod" class="form-select">
                                <option value="CASH">Cash</option>
                                <option value="CARD">Card</option>
                                <option value="MOBILE_BANKING">Mobile Banking</option>
                                <option value="DUE">Due</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Remarks</label>
                        <input name="remarks" class="form-control" />
                    </div>

                    <table class="table table-sm">
                        <tr><td>Subtotal</td><td class="text-end" id="subtotalDisplay">৳0.00</td></tr>
                        <tr><td>Line Discounts</td><td class="text-end" id="lineDiscountDisplay">-৳0.00</td></tr>
                        <tr><td>Bill Discount</td><td class="text-end" id="billDiscountDisplay">-৳0.00</td></tr>
                        <tr id="redeemRow" class="d-none"><td>Loyalty Redeem</td><td class="text-end" id="redeemDisplay">-৳0.00</td></tr>
                        <tr><td>Tax</td><td class="text-end" id="taxDisplay">৳0.00</td></tr>
                        <tr><td>Net Total</td><td class="text-end fw-bold" id="netTotalDisplay">৳0.00</td></tr>
                    </table>

                    <button type="submit" id="submitSaleBtn" class="btn btn-success w-100" disabled>Complete Sale</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const cart = [];
    const scanInput = document.getElementById('scanInput');
    const scanError = document.getElementById('scanError');
    const scanStatusBadge = document.getElementById('scanStatusBadge');

    // Same PERCENT-or-FIXED clamp-to-base logic as SalesService.ComputeDiscountAmount server-side,
    // duplicated here only so the on-screen totals preview matches what will actually be saved.
    function computeDiscountAmount(baseAmount, discountType, discountValue) {
        if (baseAmount <= 0 || !discountValue || discountValue <= 0) return 0;
        let amount = discountType === 'PERCENT' ? (baseAmount * discountValue / 100) : discountValue;
        if (amount < 0) amount = 0;
        if (amount > baseAmount) amount = baseAmount;
        return amount;
    }

    function lineGross(item) { return item.quantity * item.unitPrice; }
    function lineDiscount(item) { return computeDiscountAmount(lineGross(item), item.discountType, item.discountValue); }
    function lineNet(item) { return lineGross(item) - lineDiscount(item); }

    // Full rebuild of the cart table - only called when the SET of line items changes (add/remove),
    // never on every keystroke of the quantity box (that would destroy the input mid-typing and kick
    // focus out, which is exactly the "can't change the qty" bug this replaces).
    function renderCart() {
        const body = document.getElementById('cartBody');
        if (cart.length === 0) {
            body.innerHTML = '<tr id="emptyRow"><td colspan="7" class="text-muted text-center">No items added yet.</td></tr>';
        } else {
            body.innerHTML = cart.map((item, idx) => `
                <tr>
                    <td>${item.productName}</td>
                    <td><span class="badge text-bg-light text-dark">${item.sizeName || ''}</span></td>
                    <td>
                        <input type="number" min="1" ${item.stock ? `max="${item.stock}"` : ''} value="${item.quantity}"
                               class="form-control form-control-sm cart-qty-input" data-idx="${idx}" />
                    </td>
                    <td>${dinvMoney(item.unitPrice)}</td>
                    <td>
                        <div class="input-group input-group-sm">
                            <select class="form-select form-select-sm cart-disc-type-input" data-idx="${idx}" style="max-width:56px">
                                <option value="FIXED" ${item.discountType !== 'PERCENT' ? 'selected' : ''}>Amt</option>
                                <option value="PERCENT" ${item.discountType === 'PERCENT' ? 'selected' : ''}>%</option>
                            </select>
                            <input type="number" min="0" step="0.01" value="${item.discountValue || 0}"
                                   class="form-control form-control-sm cart-disc-value-input" data-idx="${idx}" />
                        </div>
                    </td>
                    <td class="cart-line-total" data-idx="${idx}">${dinvMoney(lineNet(item))}</td>
                    <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="removeItem(${idx})"><i class="bi bi-x"></i></button></td>
                </tr>
            `).join('');
        }

        recalculateTotals();
    }

    // Loyalty: current customer's balance/rate, fetched on demand when a registered customer
    // is picked (walk-ins and brand-new quick-add customers never have anything to redeem).
    let loyaltyInfo = { balance: 0, isEnabled: false, pointValueOnRedeem: 0 };

    // Recomputes subtotal/net + the itemsJson hidden field from the current cart array, without
    // touching any DOM input elements - safe to call on every quantity/discount/redeem keystroke.
    function recalculateTotals() {
        const grossSubtotal = cart.reduce((sum, i) => sum + lineGross(i), 0);
        const lineDiscountTotal = cart.reduce((sum, i) => sum + lineDiscount(i), 0);
        const postLineSubtotal = grossSubtotal - lineDiscountTotal;

        const billDiscountType = document.getElementById('discountType').value;
        const billDiscountValue = parseFloat(document.getElementById('discountValue').value) || 0;
        const billDiscount = computeDiscountAmount(postLineSubtotal, billDiscountType, billDiscountValue);

        const tax = parseFloat(document.getElementById('taxAmount').value) || 0;
        const preRedeemNet = Math.max(0, grossSubtotal - lineDiscountTotal - billDiscount + tax);

        // Redeem value can never exceed the bill (mirrors SalesService's server-side check) and
        // never exceeds the customer's balance (the input's max= already prevents that, but a
        // stale value from switching customers is clamped here too).
        let redeemPoints = parseInt(document.getElementById('redeemPointsInput').value, 10) || 0;
        if (redeemPoints < 0) redeemPoints = 0;
        if (redeemPoints > loyaltyInfo.balance) redeemPoints = loyaltyInfo.balance;
        let redeemAmount = loyaltyInfo.isEnabled ? redeemPoints * loyaltyInfo.pointValueOnRedeem : 0;
        if (redeemAmount > preRedeemNet) {
            redeemAmount = preRedeemNet;
        }
        document.getElementById('redeemPointsInput').value = redeemPoints;

        const net = Math.max(0, preRedeemNet - redeemAmount);

        document.getElementById('subtotalDisplay').textContent = dinvMoney(grossSubtotal);
        document.getElementById('lineDiscountDisplay').textContent = '-' + dinvMoney(lineDiscountTotal);
        document.getElementById('billDiscountDisplay').textContent = '-' + dinvMoney(billDiscount);
        document.getElementById('taxDisplay').textContent = dinvMoney(tax);
        document.getElementById('netTotalDisplay').textContent = dinvMoney(net);

        const redeemRow = document.getElementById('redeemRow');
        if (redeemPoints > 0) {
            redeemRow.classList.remove('d-none');
            document.getElementById('redeemDisplay').textContent = '-' + dinvMoney(redeemAmount);
        } else {
            redeemRow.classList.add('d-none');
        }

        document.getElementById('itemsJson').value = JSON.stringify(cart.map(i => ({
            productVariantId: i.productVariantId,
            quantity: i.quantity,
            unitPrice: i.unitPrice,
            discountType: i.discountType || 'FIXED',
            discountValue: i.discountValue || 0
        })));
        document.getElementById('submitSaleBtn').disabled = cart.length === 0;
    }

    // ---- Loyalty box: show/hide + fetch balance when a registered customer is (de)selected ----
    async function refreshLoyaltyBox() {
        const customerId = document.getElementById('customerIdSelect').value;
        const loyaltyBox = document.getElementById('loyaltyBox');
        const redeemInput = document.getElementById('redeemPointsInput');

        if (!customerId) {
            loyaltyInfo = { balance: 0, isEnabled: false, pointValueOnRedeem: 0 };
            redeemInput.value = 0;
            loyaltyBox.classList.add('d-none');
            recalculateTotals();
            return;
        }

        try {
            const response = await fetch('@Url.Action("GetCustomerLoyalty", "Sales")?customerId=' + encodeURIComponent(customerId));
            const data = await response.json();
            loyaltyInfo = data;

            if (data.isEnabled && data.balance > 0) {
                document.getElementById('loyaltyBalanceLabel').textContent = `(${data.balance} point(s) available)`;
                document.getElementById('redeemValueHint').textContent = `1 point = ৳${Number(data.pointValueOnRedeem).toFixed(2)}`;
                redeemInput.max = data.balance;
                loyaltyBox.classList.remove('d-none');
            } else {
                redeemInput.value = 0;
                loyaltyBox.classList.add('d-none');
            }
        } catch (err) {
            loyaltyInfo = { balance: 0, isEnabled: false, pointValueOnRedeem: 0 };
            loyaltyBox.classList.add('d-none');
        }

        recalculateTotals();
    }

    document.getElementById('customerIdSelect').addEventListener('change', refreshLoyaltyBox);
    document.getElementById('redeemPointsInput').addEventListener('input', recalculateTotals);

    // Typing a brand-new walk-in customer name means there's no existing balance to redeem -
    // clear the customer picker and hide the loyalty box.
    document.getElementById('newCustomerNameInput').addEventListener('input', (e) => {
        if (e.target.value.trim() === '') return;
        document.getElementById('customerIdSelect').value = '';
        refreshLoyaltyBox();
    });

    function removeItem(idx) {
        cart.splice(idx, 1);
        renderCart();
    }

    function addOrIncrementCartLine(productVariantId, productName, sizeName, unitPrice, qty, stock) {
        const existing = cart.find(i => i.productVariantId === productVariantId);
        if (existing) {
            existing.quantity += qty;
        } else {
            cart.push({ productVariantId, productName, sizeName, quantity: qty, unitPrice, stock: stock || 0, discountType: 'FIXED', discountValue: 0 });
        }
        renderCart();
    }

    // Editing the quantity/discount of an already-added line: update the line total + footer
    // totals in place (no full table rebuild) so the input never loses focus while typing.
    document.getElementById('cartBody').addEventListener('input', (e) => {
        const idx = parseInt(e.target.dataset.idx, 10);
        if (Number.isNaN(idx)) return;

        if (e.target.classList.contains('cart-qty-input')) {
            let qty = parseInt(e.target.value, 10);
            if (!Number.isFinite(qty) || qty < 1) qty = 1;
            cart[idx].quantity = qty;
        } else if (e.target.classList.contains('cart-disc-value-input')) {
            let val = parseFloat(e.target.value);
            if (!Number.isFinite(val) || val < 0) val = 0;
            cart[idx].discountValue = val;
        } else {
            return;
        }

        const lineTotalCell = document.querySelector(`.cart-line-total[data-idx="${idx}"]`);
        if (lineTotalCell) {
            lineTotalCell.textContent = dinvMoney(lineNet(cart[idx]));
        }
        recalculateTotals();
    });

    document.getElementById('cartBody').addEventListener('change', (e) => {
        if (!e.target.classList.contains('cart-disc-type-input')) return;
        const idx = parseInt(e.target.dataset.idx, 10);
        if (Number.isNaN(idx)) return;
        cart[idx].discountType = e.target.value;

        const lineTotalCell = document.querySelector(`.cart-line-total[data-idx="${idx}"]`);
        if (lineTotalCell) {
            lineTotalCell.textContent = dinvMoney(lineNet(cart[idx]));
        }
        recalculateTotals();
    });

    // ---- Scan-to-cart -------------------------------------------------------
    scanInput.addEventListener('dinv:barcode-scanned', async (e) => {
        const barcode = e.detail.barcode;
        scanError.classList.add('d-none');
        scanStatusBadge.textContent = 'Looking up ' + barcode + '...';
        scanStatusBadge.className = 'badge text-bg-warning';

        try {
            const response = await fetch('@Url.Action("ScanForSale", "Sales")?barcode=' + encodeURIComponent(barcode));
            const data = await response.json();

            if (!response.ok) {
                scanError.textContent = data.message || 'No product found for that barcode.';
                scanError.classList.remove('d-none');
                scanStatusBadge.textContent = 'Not found';
                scanStatusBadge.className = 'badge text-bg-danger';
                scanInput.value = '';
                scanInput.focus();
                return;
            }

            addOrIncrementCartLine(data.productVariantId, data.productName, data.sizeName, data.price, 1, data.stock);
            scanStatusBadge.textContent = `Added: ${data.productName} (${data.sizeName})`;
            scanStatusBadge.className = 'badge text-bg-success';
        } catch (err) {
            scanError.textContent = 'Network error while looking up the barcode.';
            scanError.classList.remove('d-none');
            scanStatusBadge.textContent = 'Error';
            scanStatusBadge.className = 'badge text-bg-danger';
        }

        scanInput.value = '';
        scanInput.focus();
    });

    // Note: the scan box only re-focuses itself right after a scan is processed (above) and on
    // initial page load (autofocus attribute) - it does NOT grab focus back on every click anywhere
    // on the page. That old behavior (dinvKeepFocused) made it impossible to use the customer picker,
    // discount/tax fields, quantity boxes, or the Complete Sale button, which is exactly what was
    // reported as "always focus on barcode scan" / "can't create new sale".

    // ---- Manual dropdown fallback ------------------------------------------
    document.getElementById('addVariantBtn').addEventListener('click', () => {
        const select = document.getElementById('variantSelect');
        const option = select.options[select.selectedIndex];
        if (!select.value) return;

        const qty = parseInt(document.getElementById('variantQty').value, 10) || 1;
        const variantId = parseInt(select.value, 10);

        addOrIncrementCartLine(variantId, option.dataset.name, option.dataset.size, parseFloat(option.dataset.price) || 0, qty, parseInt(option.dataset.stock, 10) || 0);

        select.value = '';
        document.getElementById('variantQty').value = 1;
    });

    document.getElementById('discountType').addEventListener('change', recalculateTotals);
    document.getElementById('discountValue').addEventListener('input', recalculateTotals);
    document.getElementById('taxAmount').addEventListener('input', recalculateTotals);

    renderCart();
</script>
}
