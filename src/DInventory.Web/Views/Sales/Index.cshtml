@model DInventory.Application.Common.Models.PagedResult<DInventory.Domain.Entities.SalesOrder>
@{
    ViewData["Title"] = "Sales";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <form class="d-flex gap-2" method="get">
        <input type="date" name="fromDate" value="@ViewData["FromDate"]" class="form-control form-control-sm" />
        <input type="date" name="toDate" value="@ViewData["ToDate"]" class="form-control form-control-sm" />
        <button class="btn btn-sm btn-outline-secondary" type="submit"><i class="bi bi-filter"></i></button>
    </form>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>New Sale</a>
</div>
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Invoice</th><th>Date</th><th>Customer</th><th>Net Amount</th><th>Status</th><th>By</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
                @foreach (var order in Model.Items)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@order.SalesOrderId">@order.InvoiceNo</a></td>
                        <td class="small">@order.SaleDate.ToString("g")</td>
                        <td>@(order.CustomerName ?? "Walk-in")</td>
                        <td>@order.NetAmount.ToMoney()</td>
                        <td><span class="badge @(order.Status == "COMPLETED" ? "text-bg-success" : "text-bg-danger")">@order.Status</span></td>
                        <td class="small text-muted">@order.CreatedByName</td>
                        <td class="text-end">
                            <a class="btn btn-outline-secondary btn-sm" asp-action="Details" asp-route-id="@order.SalesOrderId"><i class="bi bi-eye"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white">
            @await Html.PartialAsync("_Pagination", new PaginationViewModel
            {
                PageNumber = Model.PageNumber,
                TotalPages = Model.TotalPages,
                HasPreviousPage = Model.HasPreviousPage,
                HasNextPage = Model.HasNextPage,
                RouteValues = PaginationViewModel.Filters(
                    ("fromDate", ViewData["FromDate"]?.ToString()),
                    ("toDate", ViewData["ToDate"]?.ToString()))
            })
        </div>
    }
</div>
