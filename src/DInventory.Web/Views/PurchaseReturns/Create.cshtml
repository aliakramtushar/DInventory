@model DInventory.Domain.Entities.Purchase
@{
    ViewData["Title"] = "New Purchase Return";
    var searchResults = ViewBag.SearchResults as IEnumerable<DInventory.Domain.Entities.Purchase>;
    var searchedInvoiceNo = ViewBag.SearchedInvoiceNo as string;
}
@if (Model is null)
{
    <div class="card shadow-sm">
        <div class="card-header bg-white fw-semibold">Find the Original Purchase Invoice</div>
        <div class="card-body">
            <form method="get" class="d-flex gap-2">
                <input type="text" name="invoiceNo" class="form-control" placeholder="Enter purchase invoice no, e.g. PUR-000001" value="@searchedInvoiceNo" autofocus />
                <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Find</button>
            </form>

            @if (searchResults is not null)
            {
                if (!searchResults.Any())
                {
                    <p class="text-muted mt-3 mb-0">No purchase invoice matches "@searchedInvoiceNo".</p>
                }
                else
                {
                    <p class="text-muted mt-3 mb-2">Multiple matches - pick the invoice to return against:</p>
                    <table class="table table-sm table-hover">
                        <thead class="table-light"><tr><th>Invoice</th><th>Date</th><th>Supplier</th><th>Total</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var p in searchResults)
                            {
                                <tr>
                                    <td>@p.PurchaseInvoiceNo</td>
                                    <td class="small">@p.PurchaseDate.ToString("g")</td>
                                    <td>@p.SupplierName</td>
                                    <td>@p.TotalAmount.ToMoney()</td>
                                    <td><a class="btn btn-outline-primary btn-sm" asp-action="Create" asp-route-purchaseId="@p.PurchaseId">Select</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            }
        </div>
    </div>
}
else
{
    var returnable = Model.Items.Where(i => i.Quantity - i.ReturnedQuantity > 0).ToList();
    <div class="card shadow-sm">
        <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
            <span>Return against Purchase @Model.PurchaseInvoiceNo</span>
            <a asp-action="Create" class="btn btn-outline-secondary btn-sm">Search a different invoice</a>
        </div>
        <div class="card-body">
            <p class="text-muted mb-3">
                Supplier: @Model.SupplierName &middot; Received @Model.PurchaseDate.ToString("d")
            </p>

            @if (returnable.Count == 0)
            {
                <p class="text-muted">Every item on this purchase has already been fully returned.</p>
            }
            else
            {
                <form method="post" id="returnForm">
                    <input type="hidden" name="purchaseId" value="@Model.PurchaseId" />
                    <input type="hidden" name="itemsJson" id="itemsJson" value="[]" />

                    <table class="table table-sm align-middle">
                        <thead class="table-light"><tr><th>Product</th><th>Size</th><th>Color</th><th>Received</th><th>Already Returned</th><th>Returnable</th><th style="width:110px">Return Qty</th></tr></thead>
                        <tbody>
                            @foreach (var item in returnable)
                            {
                                var remaining = item.Quantity - item.ReturnedQuantity;
                                <tr>
                                    <td>@item.ProductName <span class="text-muted small">(@item.ProductCode)</span></td>
                                    <td><span class="badge text-bg-light text-dark">@item.SizeName</span></td>
                                    <td>@(item.ColorName ?? "-")</td>
                                    <td>@item.Quantity</td>
                                    <td>@item.ReturnedQuantity</td>
                                    <td>@remaining</td>
                                    <td>
                                        <input type="number" min="0" max="@remaining" value="0" class="form-control form-control-sm return-qty-input"
                                               data-purchase-item-id="@item.PurchaseItemId" data-max="@remaining" />
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <p class="text-muted small">Returnable is capped by what's left to return on the invoice; it's also checked against current stock on hand when you submit (can't return more than is physically in stock).</p>

                    <div class="mb-3">
                        <label class="form-label">Reason</label>
                        <input name="reason" class="form-control" placeholder="e.g. Damaged, wrong item shipped" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Remarks</label>
                        <input name="remarks" class="form-control" placeholder="Optional" />
                    </div>

                    <button type="submit" id="submitReturnBtn" class="btn btn-warning" disabled><i class="bi bi-arrow-return-right me-1"></i>Record Return</button>
                </form>
            }
        </div>
    </div>
}

@section Scripts {
<script>
(function () {
    const itemsJsonField = document.getElementById('itemsJson');
    const submitBtn = document.getElementById('submitReturnBtn');

    // This script section renders even in the "no invoice loaded yet" / "search results" /
    // "everything already returned" states, where the return form (and these elements) don't
    // exist on the page at all - bail out instead of throwing on a null itemsJsonField/submitBtn.
    if (!itemsJsonField || !submitBtn) {
        return;
    }

    const qtyInputs = document.querySelectorAll('.return-qty-input');

    function recalc() {
        const items = [];
        qtyInputs.forEach((el) => {
            let qty = parseInt(el.value, 10);
            const max = parseInt(el.dataset.max, 10);
            if (!Number.isFinite(qty) || qty < 0) qty = 0;
            if (qty > max) qty = max;
            el.value = qty;
            if (qty > 0) {
                items.push({ purchaseItemId: parseInt(el.dataset.purchaseItemId, 10), quantity: qty });
            }
        });
        itemsJsonField.value = JSON.stringify(items);
        submitBtn.disabled = items.length === 0;
    }

    qtyInputs.forEach((el) => el.addEventListener('input', recalc));
    recalc();
})();
</script>
}
