@model DInventory.Application.Common.Models.PagedResult<DInventory.Domain.Entities.Company>
@{
    ViewData["Title"] = "Companies";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <form class="d-flex gap-2" method="get">
        <input type="text" name="search" value="@ViewData["Search"]" class="form-control form-control-sm" placeholder="Search companies..." />
        <button class="btn btn-sm btn-outline-secondary" type="submit"><i class="bi bi-search"></i></button>
    </form>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>New Company</a>
</div>
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Id</th><th>Name</th><th>Short Name</th><th>Phone</th><th>Email</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No companies found.</td></tr>
                }
                @foreach (var company in Model.Items)
                {
                    <tr>
                        <td>@company.CompanyId @(company.CompanyId == 0 ? "(Superuser)" : "")</td>
                        <td>@company.CompanyName</td>
                        <td><code>@company.ShortName</code></td>
                        <td class="text-muted small">@company.Phone</td>
                        <td class="text-muted small">@company.Email</td>
                        <td>@(company.IsActive ? "Active" : "Inactive")</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@company.CompanyId"><i class="bi bi-pencil"></i></a>
                                @if (company.CompanyId != 0)
                                {
                                    <form asp-action="Delete" asp-route-id="@company.CompanyId" method="post" class="d-inline" onsubmit="return confirm('Delete this company?');">
                                        <button class="btn btn-outline-danger" type="submit"><i class="bi bi-trash"></i></button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white">
            @await Html.PartialAsync("_Pagination", new PaginationViewModel
            {
                PageNumber = Model.PageNumber,
                TotalPages = Model.TotalPages,
                HasPreviousPage = Model.HasPreviousPage,
                HasNextPage = Model.HasNextPage,
                RouteValues = PaginationViewModel.Filters(("search", ViewData["Search"]?.ToString()))
            })
        </div>
    }
</div>
