@model DInventory.Domain.Entities.Company
@using DInventory.Domain.Enums
@{
    ViewData["Title"] = "Edit Company";
}
<div class="card shadow-sm">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <form method="post">
            <input asp-for="CompanyId" type="hidden" />
            <div class="mb-3">
                <label class="form-label">Company Name <span class="text-danger">*</span></label>
                <input asp-for="CompanyName" class="form-control" required readonly="@(Model.CompanyId == 0)" />
            </div>
            <div class="mb-3">
                <label class="form-label">Short Name <span class="text-danger">*</span></label>
                <input asp-for="ShortName" class="form-control text-uppercase" style="letter-spacing: 0.05em;" required minlength="3" maxlength="15" pattern="[A-Za-z0-9]{3,15}" oninput="this.value = this.value.toUpperCase();" readonly="@(Model.CompanyId == 0)" />
                <div class="form-text">At least 3 letters/numbers, shown in capitals - used as the barcode prefix for this company (e.g. ABC000000123). Changing this only affects barcodes generated afterwards.</div>
            </div>
            <div class="mb-3">
                <label class="form-label">Phone</label>
                <input asp-for="Phone" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input asp-for="Email" type="email" class="form-control" />
            </div>
            <div class="mb-3">
                <label class="form-label">Address</label>
                <textarea asp-for="Address" class="form-control" rows="2"></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">Language</label>
                <select asp-for="Language" asp-items="Html.GetEnumSelectList<CompanyLanguage>()" class="form-select"></select>
            </div>
            @if (Model.CompanyId != 0)
            {
                <div class="form-check mb-3">
                    <input asp-for="HasECommerce" class="form-check-input" />
                    <label asp-for="HasECommerce" class="form-check-label">Has e-commerce</label>
                    <div class="form-text">Lets this company's products be shown (and priced) on the public website.</div>
                </div>
                <div class="form-check mb-3">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label">Active</label>
                </div>
            }
            else
            {
                <input asp-for="HasECommerce" type="hidden" />
            }
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
