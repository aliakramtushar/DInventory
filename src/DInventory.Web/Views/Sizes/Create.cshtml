@model DInventory.Domain.Entities.Size
@{
    ViewData["Title"] = "New Size";
    bool canCreate = ViewBag.CanCreate ?? false;
}
<div class="card shadow-sm">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        @if (!canCreate)
        {
            <div class="alert alert-warning">
                Select a company from the <strong>Company</strong> dropdown in the top navigation bar before creating a size - "All Companies" can't own one.
            </div>
        }
        <form method="post">
            <input asp-for="CompanyId" type="hidden" />
            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label">Size Name <span class="text-danger">*</span></label>
                    <input asp-for="SizeName" class="form-control" placeholder="e.g. M, XL, Free Size" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Display Order</label>
                    <input asp-for="DisplayOrder" type="number" class="form-control" />
                </div>
            </div>
            <div class="mt-4">
                <button type="submit" class="btn btn-primary" disabled="@(!canCreate)">Create Size</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
