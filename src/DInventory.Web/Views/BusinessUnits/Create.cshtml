@model DInventory.Domain.Entities.BusinessUnit
@{
    ViewData["Title"] = "New Business Unit";
    bool canCreate = ViewBag.CanCreate ?? false;
}
<div class="card shadow-sm">
    <div class="card-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        @if (!canCreate)
        {
            <div class="alert alert-warning">
                Select a company from the <strong>Company</strong> dropdown in the top navigation bar before creating a business unit - "All Companies" can't own one.
            </div>
        }
        <form method="post">
            <input asp-for="CompanyId" type="hidden" />
            <div class="mb-3">
                <label class="form-label">Business Unit Name <span class="text-danger">*</span></label>
                <input asp-for="BusinessUnitName" class="form-control" placeholder="e.g. Downtown Branch" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Address</label>
                <textarea asp-for="Address" class="form-control" rows="2" placeholder="e.g. 123 Main St, Downtown"></textarea>
            </div>
            <button type="submit" class="btn btn-primary" disabled="@(!canCreate)">Create Business Unit</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
