@model DInventory.Application.Common.Models.PagedResult<DInventory.Domain.Entities.BusinessUnit>
@{
    ViewData["Title"] = "Business Units";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <form class="d-flex gap-2" method="get">
        <input type="text" name="search" value="@ViewData["Search"]" class="form-control form-control-sm" placeholder="Search business units..." />
        <button class="btn btn-sm btn-outline-secondary" type="submit"><i class="bi bi-search"></i></button>
    </form>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>New Business Unit</a>
</div>
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Name</th><th>Company</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">No business units found.</td></tr>
                }
                @foreach (var bu in Model.Items)
                {
                    <tr>
                        <td>@bu.BusinessUnitName</td>
                        <td class="text-muted small">@bu.CompanyName</td>
                        <td>@(bu.IsActive ? "Active" : "Inactive")</td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a class="btn btn-outline-secondary" asp-action="Edit" asp-route-id="@bu.BusinessUnitId"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Delete" asp-route-id="@bu.BusinessUnitId" method="post" class="d-inline" onsubmit="return confirm('Delete this business unit?');">
                                    <button class="btn btn-outline-danger" type="submit"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white">
            @await Html.PartialAsync("_Pagination", new PaginationViewModel
            {
                PageNumber = Model.PageNumber,
                TotalCount = Model.TotalCount,
                PageSize = Model.PageSize,
                TotalPages = Model.TotalPages,
                HasPreviousPage = Model.HasPreviousPage,
                HasNextPage = Model.HasNextPage,
                RouteValues = PaginationViewModel.Filters(("search", ViewData["Search"]?.ToString()))
            })
        </div>
    }
</div>
