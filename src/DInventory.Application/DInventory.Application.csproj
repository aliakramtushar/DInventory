<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DInventory.Application</RootNamespace>
  </PropertyGroup>

  <!-- Gives this plain class library access to Microsoft.Extensions.* (Options, Caching, DI, Logging, Hosting, etc.)
       and Microsoft.AspNetCore.* APIs used by the services in this project, without needing dozens of
       individual package references that would otherwise conflict with the shared framework's own versions. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DInventory.Domain\DInventory.Domain.csproj" />
  </ItemGroup>

</Project>
